{
  "_comment": [
    "Zipcodes 235x363: flip mode, G < 10% per 18-nt axis (≤1 G).",
    "Soft targets 8/10/12/12 bits; far min 12. Homopolymer < 5 (max run 4).",
    "Printed bit mapping; require_tolerance true."
  ],
  "chip_geometry": {
    "type": "rectangular",
    "rows": 235,
    "cols": 363,
    "feature_size_microns": 14,
    "feature_spacing_microns": 16
  },
  "error_correction": {
    "type": "edit_distance",
    "distances": [8, 10, 12, 12],
    "far_features_min_distance": 12
  },
  "x_bit_length": 36,
  "y_bit_length": 36,
  "bit_to_dna": {
    "scheme": "4-bits-per-base",
    "mapping": {
      "1000": "A",
      "0100": "C",
      "0010": "T",
      "0001": "G"
    }
  },
  "sequence_qc": {
    "gc_content_min": 0.4,
    "gc_content_max": 0.6,
    "g_content_max": 0.10,
    "max_homopolymer_length": 4,
    "reject_sequences_with_long_homopolymers": true
  },
  "codebook": {
    "spacer_sequence": "",
    "feature_id_format": "row_col",
    "output_format": "csv"
  },
  "simulation": {
    "error_model": "substitution",
    "per_base_error_rate": 0.01,
    "distance_metric": "hamming",
    "max_edit_distance_for_decoding": 3
  },
  "axis_code": {
    "max_attempts_per_position": 20000,
    "backtrack_depth": 10,
    "max_backtracks": 2000,
    "random_seed": 42,
    "tolerance": 0.5,
    "candidate_mode": "flip",
    "flip_counts": [6, 7, 8, 9, 10, 11, 12, 13, 14],
    "require_tolerance": true
  }
}
